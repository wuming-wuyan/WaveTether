// 帮助正文（单独文件，避免主文件转义问题）
//
// 写法约定（改的时候请保持）：
//   每条主题开头先给「一句话」结论 —— 只想看结果的人读到第一行就够。
//   然后【怎么做】给操作步骤，最后【为什么】给技术原因和取舍。
//   不要在开头铺垫背景，也不要把原因写在结论前面。
static const wchar_t* HelpBody(int topic)
{
    switch (topic)
    {
    case HELP_CHANNEL:
        return L"一句话：蓝牙配对就能用，延迟约 150~300ms；ADB 音质更好、延迟可低到约 80ms，"
               L"但要在手机上开「USB 调试」。\n\n"
               L"【两条链路怎么选】\n"
               L"  蓝牙  不用任何设置，配对即用。延迟约 150~300ms（估计值，随手机和编码方式变）。\n"
               L"  ADB   要在手机上开 USB 调试。音质 Opus 192k，延迟默认约 220ms，\n"
               L"        设置里调到「激进」约 80ms（有线约 40ms）。可以多台同时播。\n\n"
               L"【第一次用蓝牙：配对 ≠ 连上】\n"
               L"  1. 手机开蓝牙，在 Windows 里配对这台电脑\n"
               L"  2. 回到程序「蓝牙」页，点一下你的手机那一行\n"
               L"  3. 点列表下方的「连接」\n"
               L"  之后程序会记住上次连的那台，下次启动自动连。\n\n"
               L"【推荐用法（最省事）】\n"
               L"  先用蓝牙连上，再插一次 USB 线 —— 程序会自动把 ADB 转成无线。\n"
               L"  之后在 ADB 页勾选设备，以后启动就直接走 ADB，不用再插线、也不用蓝牙。\n\n"
               L"【为什么蓝牙延迟高】\n"
               L"  蓝牙要把音频重新编码再走无线链路，链路本身就有几十毫秒，\n"
               L"  手机和电脑两端还各有一层缓冲。ADB 走 WiFi，带宽大得多，\n"
               L"  可以用低延迟编码加小缓冲，所以能压到 100ms 以内。\n\n"
               L"【为什么 ADB 一定要开 USB 调试】\n"
               L"  ADB 是安卓自带的调试通道。程序靠它在手机上启动一个小服务来抓音频，\n"
               L"  没有这个通道就抓不到。这是安卓的前提要求，不是本程序多要的权限。\n\n"
               L"【同一台设备为什么只显示一行】\n"
               L"  设备同时有 USB 和无线连接时，列表按设备身份合并成一行，优先用 USB。\n"
               L"  否则同一台机器会出现 2~4 条重复记录。";
    case HELP_PAIR:
        return L"一句话：插一次 USB 线是最快的开通方式；Android 11 以上可以「无线调试配对」一次，"
               L"之后手机重启也不用再插线。\n\n"
               L"【方式一：插 USB 线（所有安卓版本都能用）】\n"
               L"  1. 手机：设置 → 关于手机 → 连点「版本号」7 次，打开开发者选项\n"
               L"  2. 开发者选项里打开「USB 调试」\n"
               L"  3. 插线，手机上弹「允许 USB 调试吗」→ 点「允许」\n"
               L"     （有的机型要勾「一律允许使用这台计算机进行调试」才不会再弹）\n"
               L"  4. 程序会自动开通无线 ADB，之后可以拔线\n"
               L"  ⚠ 手机一重启，这个方式就失效了（无线调试端口会关掉），要再插一次线。\n"
               L"    想一次配好长期有效，用下面的方式二。\n\n"
               L"【方式二：无线调试配对（Android 11 以上，重启不掉）】\n"
               L"  1. 手机：开发者选项 → 点「无线调试」这一行文字本身\n"
               L"  2. 进去后先打开右上角的开关\n"
               L"  3. 点「使用配对码配对设备」，屏幕上会显示 IP:端口 和 6 位配对码\n"
               L"  4. 程序：设置 →「无线调试配对…」，填地址和配对码，点配对\n"
               L"  5. 回到「ADB 音频」页，勾选这台设备左边的方框（或点右侧 ▶）开始转发\n\n"
               L"  ★ 第 1 步最容易卡住：点右边的开关只是打开无线调试，不会进二级页面。\n"
               L"    必须点「无线调试」这几个字。各家品牌位置略有差别，\n"
               L"    找不到就在开发者选项里找带「无线调试」字样的那一行。\n\n"
               L"【怎么「停止转发」】\n"
               L"  就是点每台正在转发的设备右侧的 ■。全部停掉之后才能做升级。\n\n"
               L"【为什么「停止转发」才能手动升级】\n"
               L"  升级失败时最后一招是重启 adb 服务。重启会断掉所有端口转发，\n"
               L"  正在跑的转发进程立刻死掉 —— 你正在听的声音会突然断。\n"
               L"  所以有设备在转发时，程序直接拒绝这一步并提示你先停掉。\n"
               L"  （只挡正在出声的通道；双通道热备那个静音的备用通道会被一并重启。）\n"
               L"  插 USB 线自动开通也一样：那一步会让手机端的调试服务重启一次，\n"
               L"  无线连接会断一下，所以转发进行中不做。\n\n"
               L"【为什么升级要从「代价最低」开始试】\n"
               L"  顺序是：按 MAC 匹配 → 按蓝牙名匹配 → 已记录的地址 → mDNS 广播 →\n"
               L"  扫局域网 → 重启 adb 服务。越往后代价越大：扫网段会对 254 个地址\n"
               L"  发起连接，还会让旁边的安卓设备弹出「允许调试」提示。能省就省。";
    case HELP_VOLUME:
        return L"一句话：程序只调「这台设备那一路」的音量，不动 Windows 系统音量，也不去改手机音量。\n\n"
               L"【全局 / 单个】\n"
               L"  全局  一个滑块同时控制所有设备\n"
               L"  单个  只控制左侧选中的那台，标题会显示是哪台设备\n"
               L"  每台设备的音量各自记住，下次启动自动恢复。\n\n"
               L"【蓝牙和 ADB 是分开的】\n"
               L"  同一台设备走蓝牙和走 ADB 是两条不同的音频链路，\n"
               L"  音量分开保存，互不影响。标题里会标出当前调的是哪条。\n\n"
               L"【手机自己的音量键 —— 两条链路不一样】\n"
               L"  ADB 模式：手机音量键调的是手机自己的音量，和电脑这边互不影响。\n"
               L"    原因：程序抓的是「应用播放出来的音频流」，不是手机扬声器的最终输出，\n"
               L"    手机音量键作用于后者，两者在音频管线里是两个阶段。\n"
               L"  蓝牙模式：手机音量键会改变电脑这边听到的大小。\n"
               L"    原因：蓝牙送过来的就是手机输出之后的音频，手机调小，这边就跟着小。\n"
               L"    所以蓝牙下以手机音量为准，程序滑块只做微调。\n\n"
               L"【ADB 模式下手机自己会不会也响】\n"
               L"  取决于手机厂商对「播放捕获」的实现：有的机型会同时从扬声器放出来，\n"
               L"  有的不会。如果出现双声，给手机插一副耳机最省事 ——\n"
               L"  声音改走耳机，程序照样能抓到。\n\n"
               L"【为什么不去调系统音量】\n"
               L"  Windows 的系统音量是全局的，改它会把游戏、音乐、通话一起调小。\n"
               L"  程序改成只调那条音频会话的音量，别的程序完全不受影响。\n"
               L"  代价是：Windows 没有「按程序分音量」的标准入口，得自己找会话，\n"
               L"  而且不同设备、不同链路要分别处理，比调全局音量麻烦得多。";
    case HELP_OUTPUT:
        return L"一句话：把耳机勾上并排到第一位，程序连上手机时就会把声音送到它。\n\n"
               L"【怎么用】\n"
               L"  列表按优先级从上到下排列，「优先级勾选框」勾上的才参与自动切换。\n"
               L"  点设备行   = 立刻把系统输出切到该设备（全局生效，游戏声音也会跟着切）\n"
               L"  点勾选框   = 只改优先级，不立刻切换\n"
               L"  改顺序     = 先点一下设备行选中，再点上面的「上移」/「下移」\n"
               L"  「使用中」标签 = 当前系统正在用这个设备\n\n"
               L"【为什么要按优先级排】\n"
               L"  你可能同时有耳机、音箱、虚拟声卡。程序连上设备时希望送到你正在用的那个，\n"
               L"  但它自己判断不了哪个是「正在用」，所以让你排个序，它按顺序挑第一个可用的。\n\n"
               L"【重要限制】\n"
               L"  Windows 不允许把「某个程序的声音」单独送到某个设备，\n"
               L"  所以这里切换是全局的 —— 游戏、音乐、提示音都会一起切过去。\n"
               L"  这是系统的限制，不是程序偷懒。";
    case HELP_FIXED:
        return L"一句话：勾上这一项，连上手机时自动把系统输出切到你的耳机，断开时自动还原。\n\n"
               L"【两种模式】\n"
               L"  勾选「连接时切到优先级列表里的设备」\n"
               L"          连接设备时自动切到优先级第一个可用设备；断开时还原。\n"
               L"  不勾选  完全跟随系统默认输出，本程序不改动任何系统设置。\n\n"
               L"【什么时候该勾】\n"
               L"  笔记本外接耳机、又不想每次手动切输出 —— 勾上。\n"
               L"  你本来就自己管输出设备，不想让程序插手 —— 不勾。\n\n"
               L"【为什么会有「还原」这一步】\n"
               L"  不还原的话，你拔掉手机之后声音还留在那个设备上，\n"
               L"  会变成「电脑没声音、也找不到原因」。还原是为了不留后遗症。";
    case HELP_MULTI:
        return L"一句话：蓝牙一次只能接一台设备；ADB 可以多台同时播，各自独立音量。\n\n"
               L"【为什么蓝牙只能一台】\n"
               L"  A2DP 是一对一的点对点音频链路：手机把音频编码后推给一个接收端，\n"
               L"  接收端只维护一条解码加播放通道。Windows 的蓝牙协议栈也只暴露\n"
               L"  一个 A2DP 接收端，后连的设备会把前一台顶掉。\n"
               L"  这不是本程序的限制，任何蓝牙音频方案都一样。\n\n"
               L"【ADB 为什么可以多台】\n"
               L"  每台设备各跑一个独立的抓取进程，各自在 Windows 里注册一条音频会话，\n"
               L"  系统天然支持多路混音。所以能同时播、能分别调音量、能分别静音。\n\n"
               L"【前提】\n"
               L"  每台设备都要先开通一次 ADB（插 USB 线，或用无线调试配对）。\n"
               L"  设备多的时候注意：每台设备都会占用一点 CPU 和 WiFi 带宽。";
    case HELP_STATUS:
        return L"一句话：标题栏圆点是总览；设备行两个点 = 左边「有没有在转发」，右边「有没有音频在流」。\n\n"
               L"【标题栏圆点】\n"
               L"  灰点  未连接\n"
               L"  黄点  正在连接 / 等待设备发起连接\n"
               L"  绿点  已连接，当前没有播放（含已静音）\n"
               L"  蓝点  已连接，并且正在播放声音\n"
               L"  红点  连接失败\n\n"
               L"【设备行的两个点】\n"
               L"  PC    绿点 = 电脑侧正在转发（抓取进程在跑）\n"
               L"        灰点 = 没有转发\n"
               L"  设备  绿点 = 这条音频会话确实有声音（读的是电脑侧峰值）\n"
               L"        灰点 = 没有声音\n\n"
               L"【两端都绿才是真正在播放】\n"
               L"  PC 绿但设备灰 = 通道通了，但没声音（常见：音频被蓝牙抢走、\n"
               L"  或应用自己静音了）。这是排查「没声音」最快的切入点。\n"
               L"  这里读的是电脑侧这条音频会话的真实峰值（不打扰手机）。\n\n"
               L"【设备行上的文字状态】\n"
               L"  （未转发）    「单个」模式下，右侧「手机声音」卡标题会出现这四个字，\n"
               L"                意思是还没开始抓取。\n"
               L"                勾选设备左边的方框，或点右侧 ▶ 即可。\n"
               L"  离线          手机上连不上了（常见于手机重启、或 WiFi 休眠）。\n"
               L"                插一次 USB 线，或用「无线调试配对」重连。\n"
               L"  未用于音频    蓝牙已配对但此刻没声音，正常 ——\n"
               L"                蓝牙只在真有声音时才建立音频链路。\n"
               L"  无线 · 已配对（重启不掉）\n"
               L"                用「无线调试配对」开通的，手机重启也能自己连回来。\n"
               L"  无线 · 未配对（重启要插线）\n"
               L"                用插线方式开通的，手机重启后要再插一次线。\n\n"
               L"【▶ 和 ■】\n"
               L"  ▶ 开始转发 / ■ 停止转发。勾选过的设备上线会自动转发；\n"
               L"  手动点过 ■ 的那台不会自己起来，要恢复就再点 ▶。\n\n"
               L"【为什么不用系统的「会话是否活跃」判断】\n"
               L"  安卓那条会话空闲时也会报「活跃」，看着像在播其实没声音。\n"
               L"  所以改成读真实音频峰值，有声音才算在播。";
    case HELP_TROUBLE:
        return L"一句话：九成问题看两处就能定位 —— 顶部提示条写了原因和下一步，"
               L"设备行的 PC 点告诉你转发有没有起来。\n\n"
               L"· 设备扬声器还在响、电脑没声音\n"
               L"  说明音频没有被接管。先看设备行：PC 点亮了吗？设备点亮了吗？\n"
               L"  PC 点不亮 → 转发没起来，点「刷新」或重新点 ▶。\n"
               L"  两个都亮但没声音 → 大概率是音频被蓝牙抢走了。\n"
               L"    程序每 30 秒检查一次，发现被蓝牙占用就自动断开（多设备时只看第一台）；\n"
               L"    也可以手动断开蓝牙后重试。\n"
               L"  少数机型会拦截系统的音频重定向，那就改用蓝牙通道。\n\n"
               L"· ADB 连不上\n"
               L"  1. 确认设备和电脑在同一个 WiFi\n"
               L"  2. 插一次 USB 线，确认手机上点了「允许 USB 调试」\n"
               L"  3. 手机重启后老办法会失效，需要重新插线；\n"
               L"     Android 11 以上建议改用「无线调试配对」，配对一次长期有效\n\n"
               L"· 断线后会不会自动恢复\n"
               L"  默认会：WiFi 断开重连、进程崩溃、手机睡醒之后，程序都会自己找回来。\n"
               L"  不想要这种行为，可以在「设置 → 无线连接断开后」关掉「自动重连」。\n"
               L"  关掉后掉线就停在那儿（启动后约两分钟内仍会照常连上），\n"
               L"  要恢复就点「刷新」。\n\n"
               L"· 设备 IP 变了怎么办\n"
               L"  默认找不回来（不会扫网段，见「为什么这样设计」）。\n"
